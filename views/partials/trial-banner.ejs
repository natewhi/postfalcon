<% if (planBanner === 'start') { %>
<section class="verify-banner trial-banner">
  <span>You're on the free plan: Mastodon, Bluesky and Telegram. Start a 7-day free trial to add Facebook, Instagram, YouTube, TikTok and more.</span>
  <a class="banner-action" href="/pricing">Choose a plan</a>
</section>
<% } else if (planBanner === 'lapsed') { %>
<section class="verify-banner trial-banner">
  <span>Your trial or subscription has ended, so only Mastodon, Bluesky and Telegram still publish. Reactivate for the rest.</span>
  <a class="banner-action" href="/pricing">Reactivate</a>
</section>
<% } %>
