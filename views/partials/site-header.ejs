<%
  // `loggedIn` is optional — views that don't pass it (auth pages, 404) render the
  // logged-out header.
  var _loggedIn = (typeof loggedIn !== 'undefined') && loggedIn;
  // Self-hosted mode (no Stripe) has nothing to sell: no Pricing link, a plain Sign up.
  var _billing = (typeof billingEnabled === 'undefined') || billingEnabled;
%>
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-brand" aria-label="<%= siteName %> home">
      <svg class="site-brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect width="40" height="40" rx="9" fill="#1f2430"/>
        <path fill-rule="evenodd" fill="#ffffff" transform="rotate(20 21.5 20)" d="M13 9Q13 8 14 8L22 8C26.4 8 30 11.6 30 16 30 20.4 26.4 24 22 24L20 24 20 31Q20 32 19 32L14 32Q13 32 13 31ZM20 12L22 12C24.5 12 26 13.8 26 16 26 18.2 24.5 20 22 20L20 20Z"/>
      </svg>
      <span><%= siteName %></span>
    </a>
    <nav class="site-nav">
      <% if (_billing) { %><a href="/pricing">Pricing</a><% } %>
      <% if (blogEnabled) { %><a href="/blog">Blog</a><% } %>
      <a href="/api-docs">API</a>
      <% if (_loggedIn) { %>
        <a href="/dashboard" class="btn-link">Open app</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <% if (_billing) { %>
          <a href="/pricing" class="btn-link">Start free trial</a>
        <% } else { %>
          <a href="/signup" class="btn-link">Sign up</a>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>
