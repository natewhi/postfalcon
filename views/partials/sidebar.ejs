<%- include('platform-icons') %>
<aside class="sidebar">
  <a href="/dashboard" class="sidebar-brand" aria-label="Postfalcon home">
    <svg class="sidebar-brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect width="40" height="40" rx="9" fill="#1f2430"/>
      <path fill-rule="evenodd" fill="#ffffff" transform="rotate(20 21.5 20)" d="M13 9Q13 8 14 8L22 8C26.4 8 30 11.6 30 16 30 20.4 26.4 24 22 24L20 24 20 31Q20 32 19 32L14 32Q13 32 13 31ZM20 12L22 12C24.5 12 26 13.8 26 16 26 18.2 24.5 20 22 20L20 20Z"/>
    </svg>
    <span>Postfalcon</span>
  </a>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-link<%= active === 'calendar' ? ' active' : '' %>">Calendar</a>
    <a href="/analytics" class="nav-link<%= active === 'analytics' ? ' active' : '' %>">Analytics</a>
    <a href="/accounts" class="nav-link<%= active === 'accounts' ? ' active' : '' %>">Accounts</a>
    <a href="/settings" class="nav-link<%= active === 'settings' ? ' active' : '' %>">Settings</a>
  </nav>

  <div class="sidebar-accounts">
    <div class="sidebar-section-label">Connected accounts</div>
    <div id="sidebar-accounts-list"></div>
  </div>

  <div class="sidebar-footer">
    <button id="theme-toggle-btn" type="button" class="theme-toggle-btn" aria-pressed="false">🌓 Theme</button>
    <span class="sidebar-email"><%= email %></span>
    <button id="logout-btn" type="button">Log out</button>
  </div>
</aside>
