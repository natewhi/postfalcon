<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Postfalcon — Schedule your social posts in one place</title>
<meta name="description" content="Postfalcon lines up your posts for <%= platformNames %> on one calendar, then publishes them on time. Open source, self-hostable, with an API and MCP server for AI agents.">
<link rel="icon" href="<%= logoUrl || '/favicon.svg' %>">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
<div class="landing landing-home">
  <%- include('partials/platform-icons') %>

  <%- include('partials/site-header') %>

  <main>
    <section class="home-hero">
      <svg class="home-squig home-squig-1" viewBox="0 0 224 60" aria-hidden="true">
        <path d="M6 34C22 12 42 8 58 26 72 42 92 48 110 32 126 18 148 12 168 30 182 42 202 46 218 28" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      </svg>
      <svg class="home-squig home-squig-2" viewBox="0 0 116 84" aria-hidden="true">
        <path d="M8 70C18 46 36 38 50 54 60 66 76 64 84 46 90 34 102 30 110 14" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      </svg>
      <svg class="home-squig home-squig-3" viewBox="0 0 262 52" aria-hidden="true">
        <path d="M6 28C30 10 58 10 84 24 108 37 138 40 164 24 188 10 216 10 240 24 250 29 257 27 259 22" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      </svg>

      <div class="home-hero-inner">
        <h1>
          Post everywhere, by hand or
          <span class="home-mark">by agent.<svg class="home-mark-line" viewBox="0 0 320 22" preserveAspectRatio="none" aria-hidden="true"><path d="M5 14C70 5 150 5 210 10s70 6 105 1" stroke="currentColor" stroke-width="9" stroke-linecap="round" fill="none"/></svg></span>
        </h1>
        <%
          // The tiles below already show every platform, so the lead names the first few.
          const leadNames = livePlatforms.map((p) => p.label);
          const leadPlatforms = leadNames.length > 5
            ? `${leadNames.slice(0, 4).join(', ')} and ${leadNames.length - 4} more`
            : platformNames;
        %>
        <p class="home-hero-lead">
          Write once, schedule it on one calendar, and <%= siteName %> publishes it on time to
          <%= leadPlatforms %>.
        </p>
        <div class="home-hero-actions">
          <% if (billingEnabled) { %>
            <a href="/pricing" class="home-btn home-btn-primary">Start free trial</a>
            <a href="https://github.com/postfalcon/postfalcon" class="home-textlink">Or self-host it free &rarr;</a>
          <% } else { %>
            <a href="/signup" class="home-btn home-btn-primary">Get started</a>
            <a href="#analytics-demo" class="home-textlink">See your analytics &rarr;</a>
          <% } %>
        </div>
        <% if (billingEnabled) { %>
        <p class="home-hero-note">Free for Mastodon, Bluesky and Telegram &middot; no card needed</p>
        <% } %>

        <div class="home-tiles">
          <% livePlatforms.forEach((p) => { %>
          <span class="home-tile is-live" style="--tile: <%= p.color %>" title="<%= p.label %>">
            <svg class="home-tile-glyph" viewBox="0 0 24 24" aria-hidden="true"><use href="#pi-<%= p.id %>"></use></svg>
          </span>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="home-showcase">
      <%
        /* Static replicas of the dashboard (dashboard.ejs): the "New post" composer and the
           FullCalendar month view, dated from today on every render so they never look stale.
           The composer's post is the one on tomorrow's calendar cell at 9a. */
        const F = '#1877f2', I = '#e1306c', M = '#6364ff', T = '#26a5e4', Y = '#ff0000', B = '#1185fe';
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
        const tomorrow = addDays(today, 1);

        const mockPost = 'Ship note v2.1: recurring posts and outbound webhooks are here 🎉 Set a post up once and Postfalcon keeps it going.';
        const mockWhen = tomorrow.toLocaleString('en-US', { month: 'short', day: 'numeric' }) + ', 9:00 AM';
        const mockDate = tomorrow.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

        // [days from today, status, platform, badge colour, time, title]
        const calPosts = [
          [-8, 'posted', 'facebook', F, '10a', 'Customer story'],
          [-5, 'posted', 'mastodon', M, '9a', 'v2.0 is live 🎉'],
          [-4, 'failed', 'instagram', I, '5p', 'Launch teaser'],
          [-2, 'posted', 'bluesky', B, '11a', 'Behind the scenes'],
          [1, 'scheduled', 'mastodon', M, '9a', 'Ship note v2.1'],
          [1, 'scheduled', 'bluesky', B, '9a', 'Ship note v2.1'],
          [2, 'scheduled', 'instagram', I, '12:30p', 'BTS carousel'],
          [6, 'scheduled', 'facebook', F, '10a', 'Feature spotlight'],
          [7, 'scheduled', 'youtube', Y, '8a', 'Tutorial drop'],
          [8, 'scheduled', 'telegram', T, '7p', 'AMA reminder'],
          [14, 'scheduled', 'mastodon', M, '3p', 'Roadmap thread'],
          [15, 'scheduled', 'instagram', I, '1p', 'Poll: what next?'],
        ];
        const eventsByDay = new Map();
        calPosts.forEach(([offset, k, b, c, t, x]) => {
          const key = addDays(today, offset).getTime();
          eventsByDay.set(key, [...(eventsByDay.get(key) || []), { k, b, c, t, x }]);
        });
        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
        const daysInMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0).getDate();
        const gridStart = addDays(monthStart, -monthStart.getDay());
        const weekCount = Math.ceil((monthStart.getDay() + daysInMonth) / 7);
        const cells = Array.from({ length: weekCount * 7 }, (_, i) => {
          const day = addDays(gridStart, i);
          return {
            d: day.getDate(),
            other: day.getMonth() !== today.getMonth(),
            past: day < today,
            today: day.getTime() === today.getTime(),
            ev: eventsByDay.get(day.getTime()) || [],
          };
        });
        const monthTitle = today.toLocaleString('en-US', { month: 'long', year: 'numeric' });
        const scheduledCount = calPosts.filter((p) => p[1] === 'scheduled').length;
        const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      %>
      <figure class="home-shot home-shot-compose">
        <div class="home-window" aria-hidden="true">
          <div class="home-window-bar">
            <span></span><span></span><span></span>
            <span class="home-window-title"><%= siteName %> &mdash; New post</span>
          </div>
          <div class="home-window-body mock-composer">
            <div class="mock-main">
              <div class="mock-field">
                <span class="mock-label">Post to</span>
                <div class="mock-accounts">
                  <span class="mock-chip is-selected"><span class="mock-avatar" style="--b: <%= M %>">P<svg viewBox="0 0 24 24"><use href="#pi-mastodon"></use></svg></span>@postfalcon</span>
                  <span class="mock-chip is-selected"><span class="mock-avatar" style="--b: <%= B %>">P<svg viewBox="0 0 24 24"><use href="#pi-bluesky"></use></svg></span>postfalcon.co</span>
                  <span class="mock-chip"><span class="mock-avatar" style="--b: <%= T %>">P<svg viewBox="0 0 24 24"><use href="#pi-telegram"></use></svg></span>Postfalcon news</span>
                </div>
              </div>
              <div class="mock-field">
                <span class="mock-label">Caption</span>
                <p class="mock-textarea"><%= mockPost %></p>
                <div class="mock-meta"><span><%= mockPost.length %> characters</span></div>
              </div>
              <div class="mock-field">
                <span class="mock-label">Media</span>
                <div class="mock-media">
                  <span class="mock-media-thumb" aria-hidden="true"></span>
                  <span class="mock-upload">Add photo or video <span>(up to 10)</span></span>
                </div>
              </div>
            </div>
            <div class="mock-side">
              <div class="mock-field">
                <span class="mock-label">Preview</span>
                <div class="mock-pv-tabs">
                  <span class="is-active"><span class="mock-avatar" style="--b: <%= M %>">P<svg viewBox="0 0 24 24"><use href="#pi-mastodon"></use></svg></span>@postfalcon</span>
                  <span><span class="mock-avatar" style="--b: <%= B %>">P<svg viewBox="0 0 24 24"><use href="#pi-bluesky"></use></svg></span>postfalcon.co</span>
                </div>
                <div class="mock-pv-card">
                  <div class="mock-pv-head">
                    <span class="mock-avatar is-large" style="--b: <%= M %>">P<svg viewBox="0 0 24 24"><use href="#pi-mastodon"></use></svg></span>
                    <span><strong>@postfalcon</strong><small><%= mockWhen %> &middot; Mastodon</small></span>
                  </div>
                  <p><%= mockPost %></p>
                  <span class="mock-pv-image" aria-hidden="true"></span>
                </div>
              </div>
              <div class="mock-field">
                <span class="mock-label">When</span>
                <div class="mock-toggle">
                  <span>Save as draft</span>
                  <span>Post now</span>
                  <span class="is-active">Schedule</span>
                </div>
                <div class="mock-quick">
                  <span>In 1 hour</span>
                  <span>Tomorrow morning</span>
                  <span>Next Monday morning</span>
                </div>
                <div class="mock-inputs">
                  <span><small>Date</small><span class="mock-input"><%= mockDate %></span></span>
                  <span><small>Time</small><span class="mock-input">9:00 AM</span></span>
                  <span><small>Repeat</small><span class="mock-input">Every week</span></span>
                </div>
              </div>
              <div class="mock-actions">
                <span>Cancel</span>
                <span class="is-primary">Save</span>
              </div>
            </div>
          </div>
        </div>
        <figcaption>One form for the text, the accounts to cross-post to, media, and when it goes out &mdash; right now, at a set time, or on repeat &mdash; with a preview of each post.</figcaption>
      </figure>

      <figure class="home-shot">
        <div class="home-window" aria-hidden="true">
          <div class="home-window-bar">
            <span></span><span></span><span></span>
            <span class="home-window-title"><%= siteName %> &mdash; Calendar</span>
          </div>
          <div class="home-window-body">
            <div class="fcm-header">
              <strong>Calendar</strong>
              <span class="fcm-new">+ New post</span>
            </div>
            <div class="fcm-stats">
              <span><strong><%= scheduledCount %></strong> scheduled</span>
              <span><strong>2</strong> drafts</span>
              <span><strong>1</strong> failed</span>
            </div>
            <div class="fcm-filter">
              <span>Show:</span>
              <span class="fcm-chip is-on">Scheduled</span>
              <span class="fcm-chip is-on">Failed</span>
              <span class="fcm-chip is-on">Posted</span>
              <span class="fcm-chip">Canceled</span>
            </div>
            <div class="fcm-toolbar">
              <div class="fcm-btns">
                <span class="fcm-nav"><button type="button">&lsaquo;</button><button type="button">&rsaquo;</button></span>
                <button type="button">today</button>
              </div>
              <div class="fcm-title"><%= monthTitle %></div>
              <div class="fcm-views">
                <button type="button" class="is-active">month</button><button type="button">week</button>
              </div>
            </div>
            <div class="fcm-grid">
              <div class="fcm-row fcm-head">
                <% weekdays.forEach((w) => { %><div><%= w %></div><% }); %>
              </div>
              <% for (let wk = 0; wk < weekCount; wk++) { %>
              <div class="fcm-row">
                <% for (let i = 0; i < 7; i++) { const cell = cells[wk * 7 + i]; %>
                <div class="fcm-day<%= cell.other ? ' is-other' : '' %><%= cell.past ? ' is-past' : '' %><%= cell.today ? ' is-today' : '' %>">
                  <span class="fcm-daynum"><%= cell.d %></span>
                  <% cell.ev.forEach((e) => { %>
                  <span class="fcm-event ev-<%= e.k %>">
                    <span class="fcm-badge" style="--b: <%= e.c %>"><svg class="platform-glyph" viewBox="0 0 24 24" aria-hidden="true"><use href="#pi-<%= e.b %>"></use></svg></span>
                    <span class="fcm-time"><%= e.t %></span>
                    <span class="fcm-evtitle"><%= e.x %></span>
                    <% if (e.k === 'posted') { %><span class="fcm-mark">&#10003;</span><% } %>
                    <% if (e.k === 'failed') { %><span class="fcm-mark">&#8635;</span><% } %>
                  </span>
                  <% }); %>
                </div>
                <% } %>
              </div>
              <% } %>
            </div>
          </div>
        </div>
        <figcaption>Drag a scheduled post to move it &middot; filter by status &middot; scheduled, posted and failed on one grid, with one-click retry.</figcaption>
      </figure>
    </section>

    <section id="analytics-demo" class="home-section home-analytics-section">
      <div class="home-analytics-inner">
        <div class="home-analytics-copy">
          <p class="home-overline">Post analytics</p>
          <h2 class="home-h2">See what&rsquo;s working, automatically.</h2>
          <p>
            A few times a day, Postfalcon pulls fresh view, like, comment, and share counts straight
            from each connected platform&rsquo;s API and lines them up on one chart &mdash; no
            exporting, no switching apps, no spreadsheets.
          </p>
          <p>
            It&rsquo;s the same data your agent can read too: ask it for the numbers and it&rsquo;ll
            tell you what&rsquo;s landing.
          </p>
        </div>
        <div class="home-window home-analytics-window" aria-hidden="true">
          <div class="home-window-bar">
            <span></span><span></span><span></span>
            <span class="home-window-title"><%= siteName %> &mdash; Analytics</span>
          </div>
          <div class="home-window-body home-analytics-mock">
            <div class="home-analytics-stats">
              <div><strong>3,180</strong><span>Views</span></div>
              <div><strong>266</strong><span>Likes</span></div>
              <div><strong>41</strong><span>Comments</span></div>
              <div><strong>9</strong><span>Shares</span></div>
            </div>
            <div class="home-analytics-chart">
              <span style="--h: 30%"></span>
              <span style="--h: 48%"></span>
              <span style="--h: 40%"></span>
              <span style="--h: 100%" class="is-peak"></span>
              <span style="--h: 64%"></span>
              <span style="--h: 56%"></span>
              <span style="--h: 72%"></span>
            </div>
            <p class="home-analytics-insight">Top post this week: <strong>1.2k views</strong> on YouTube</p>
          </div>
        </div>
      </div>
    </section>

    <section id="why" class="home-section home-section--why">
      <div class="home-why-inner">
        <div class="home-window home-why-window" aria-hidden="true">
          <div class="home-window-bar">
            <span></span><span></span><span></span>
            <span class="home-window-title">your-server &mdash; postfalcon</span>
          </div>
          <div class="home-window-body home-why-mock">
            <p><span class="home-why-prompt">$</span> curl -fsSL https://postfalcon.co/install.sh | sh</p>
            <p class="home-why-out">Domain or IP address: <span>social.example.com</span></p>
            <p class="home-why-out">Downloading and starting Postfalcon...</p>
            <p class="home-why-out">Postfalcon is running. Open https://social.example.com</p>
            <p class="home-why-ok">Open source. Self-hosted. <strong>Your data never leaves your server.</strong></p>
          </div>
        </div>
        <div class="home-why-copy">
          <p class="home-overline">Why Postfalcon</p>
          <h2 class="home-h2">Run it yourself, or let us.</h2>
          <% if (billingEnabled) { %>
          <p>
            Postfalcon is open source, so you get a real choice: <a href="/pricing">start a hosted
            trial</a> and we run it for you, no server required, or run it on your own server and
            keep everything there.
          </p>
          <p>
            Self-hosting is one command. It sets everything up with Docker, including HTTPS and
            nightly backups, and the first account becomes the admin. Users, invites, platforms
            and backups are all managed from the admin panel, with no config files or database
            commands.
          </p>
          <a href="https://github.com/postfalcon/postfalcon" class="home-textlink">See the code on GitHub &rarr;</a>
          <% } else { %>
          <p>
            It&rsquo;s open source and running on this server, so your access tokens live in this
            server&rsquo;s database, not a third party&rsquo;s, and the scheduler keeps posting on
            time whether or not you&rsquo;re logged in.
          </p>
          <% } %>
        </div>
      </div>
    </section>

    <section id="agents" class="home-section home-agent">
      <div class="home-agent-inner">
        <div class="home-agent-copy">
          <p class="home-overline">Built for AI agents</p>
          <h2 class="home-h2">Hand the calendar to your agent.</h2>
          <p>
            Postfalcon ships a documented REST API and an MCP server reachable two ways &mdash; a
            local command for Claude Desktop and Cursor, or a remote URL for ChatGPT, Claude.ai,
            OpenClaw, and anything else that speaks MCP. Point any of them at your account and
            let it draft, schedule, and reshuffle posts with the same permissions you have.
          </p>
          <ol class="home-agent-steps">
            <li><span class="home-agent-step-num">1</span><span>Create an API token in <strong>Settings &rarr; API access for agents</strong>.</span></li>
            <li><span class="home-agent-step-num">2</span><span>Give it to your agent: as a local MCP config, a remote MCP URL, or for the REST API.</span></li>
            <li><span class="home-agent-step-num">3</span><span>Ask it to post. It gets 6 tools covering accounts, posts and analytics.</span></li>
          </ol>
          <a href="/api-docs" class="home-textlink">Read the API &amp; MCP docs &rarr;</a>
        </div>
        <div class="home-terminal home-agent-chat">
          <div class="home-terminal-head">
            <span class="home-terminal-dots"><i></i><i></i><i></i></span>
            <span class="home-terminal-label">Claude &middot; connected to Postfalcon</span>
          </div>
          <div class="home-agent-chat-body">
            <p class="home-agent-msg">Schedule this launch note for Mastodon and Bluesky, then queue a recap for next Friday at 5pm.</p>
            <div class="home-agent-tool">
              <span class="home-agent-tool-name">create_post</span>
              <span class="home-agent-tool-detail">mastodon</span>
              <svg class="home-agent-tool-check" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="home-agent-tool">
              <span class="home-agent-tool-name">create_post</span>
              <span class="home-agent-tool-detail">bluesky</span>
              <svg class="home-agent-tool-check" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="home-agent-tool">
              <span class="home-agent-tool-name">create_post</span>
              <span class="home-agent-tool-detail">scheduled &middot; Fri 5:00p</span>
              <svg class="home-agent-tool-check" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="home-agent-reply">Posted to Mastodon and Bluesky, and the recap is queued for Friday at 5:00pm.</p>
          </div>
        </div>
      </div>
    </section>

    <% if (billingEnabled) { %>
    <section class="home-section home-pricing-teaser">
      <h2 class="home-h2">Simple <span class="underline-mark">pricing.<svg class="underline-mark-line" viewBox="0 0 320 22" preserveAspectRatio="none" aria-hidden="true"><path d="M5 14C70 5 150 5 210 10s70 6 105 1" stroke="currentColor" stroke-width="9" stroke-linecap="round" fill="none"/></svg></span></h2>
      <p class="home-hero-lead">Every plan starts with a 7-day free trial. Cancel anytime.</p>
      <p class="home-hero-lead">Only posting to Mastodon, Bluesky or Telegram? That's free, with no card: <a href="/signup">sign up free</a>.</p>

      <%- include('partials/pricing-cards', { headingTag: 'h3', loggedIn: false, currentPlan: null }) %>

      <p class="pricing-footnote">
        Prices in USD. Every plan includes cross-posting, recurring posts, the REST API and the
        MCP server for AI agents. Change plan or cancel anytime from the billing portal.
      </p>
    </section>
    <% } %>

    <section class="home-section home-faq">
      <div class="home-band">
        <p class="home-overline">FAQ</p>
        <h2 class="home-h2">Questions, answered.</h2>
        <div class="home-faq-list">
          <details>
            <summary>Which platforms work today?</summary>
            <p><%= platformNames %>.<% if (!livePlatforms.some((p) => p.id === 'x')) { %> X (formerly Twitter) isn&rsquo;t included yet &mdash; its API isn&rsquo;t free.<% } %></p>
          </details>
          <details>
            <summary>Is my data safe?</summary>
            <% if (billingEnabled) { %>
            <p>Your posts and connected accounts are only ever used to publish what you schedule. They&rsquo;re never sold or shared. If you&rsquo;d rather nothing leaves your own server, self-host it: it&rsquo;s the same software.</p>
            <% } else { %>
            <p>Everything stays on this server: your posts, and the access tokens for your connected accounts, live in its own database, with no third party in the middle.</p>
            <% } %>
          </details>
          <details>
            <summary>Can I run it on my own server?</summary>
            <p>Yes. It&rsquo;s open source (AGPL-3.0) and installs with one command on any Linux server with Docker: <code>curl -fsSL https://postfalcon.co/install.sh | sh</code>. Self-hosted, every feature is included with no plan limits. The code is on <a href="https://github.com/postfalcon/postfalcon">GitHub</a>.</p>
          </details>
          <% if (billingEnabled) { %>
          <details>
            <summary>Is there a free trial?</summary>
            <p>Yes &mdash; every plan starts with a 7-day free trial. Posting to Mastodon, Bluesky and Telegram is free, with no card and no time limit. You can also run Postfalcon yourself: it&rsquo;s open source.</p>
          </details>
          <% } %>
          <details>
            <summary>Can an AI agent run it?</summary>
            <p>Yes &mdash; any of them. There&rsquo;s a documented REST API and an MCP server reachable both as a local command (Claude Desktop, Cursor) and a remote URL (ChatGPT, Claude.ai, or anything else that speaks MCP).</p>
          </details>
          <details>
            <summary>Do you ever see my account passwords?</summary>
            <p>No. You connect each account through that platform&rsquo;s own login screen, except Telegram, which uses a bot token, and Bluesky, which uses an app password you can revoke at any time. Postfalcon never sees, and never stores, your real password.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="home-final">
      <h2>Your next week of posts, done before lunch.</h2>
      <% if (billingEnabled) { %>
        <a href="/pricing" class="home-btn home-btn-primary home-btn-lg">Start your free trial</a>
      <% } else { %>
        <a href="/signup" class="home-btn home-btn-primary home-btn-lg">Get started</a>
      <% } %>
    </section>
  </main>

  <footer class="landing-footer">
    <span>&copy; <%= new Date().getFullYear() %> Postfalcon<% if (operatorName) { %> &middot; operated by <%= operatorName %><% if (operatorAbn) { %> (ABN <%= operatorAbn %>)<% } %><% } %></span>
    <% if (billingEnabled) { %><a href="/pricing">Pricing</a><% } %>
    <% if (blogEnabled) { %><a href="/blog">Blog</a><% } %>
    <a href="/api-docs">API docs</a>
    <a href="https://github.com/postfalcon/postfalcon">Source code</a>
