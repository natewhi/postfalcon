<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js"></script>
<meta name="color-scheme" content="light dark">
<title>Postfox — Schedule your social posts in one place</title>
<meta name="description" content="Plan, schedule, and publish to Mastodon, Facebook, and Instagram from one calendar, with API access for AI agents.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="landing">
  <header class="landing-nav">
    <div class="landing-brand">Postfox</div>
    <nav class="landing-nav-links">
      <a href="/login">Log in</a>
      <a href="/signup" class="btn-link">Sign up free</a>
    </nav>
  </header>

  <main>
    <section class="landing-hero">
      <h1>Schedule your social posts, in one place.</h1>
      <p class="landing-subhead">
        Plan, schedule, and publish to Mastodon, Facebook, and Instagram from a single calendar &mdash;
        with API access so your AI agents can draft and post for you too.
      </p>
      <div class="landing-cta">
        <a href="/signup" class="btn-link btn-lg">Get started free</a>
        <a href="/login" class="btn-secondary btn-lg">Log in</a>
      </div>
    </section>

    <section class="landing-features">
      <div class="landing-feature">
        <span class="landing-feature-icon">📅</span>
        <h3>Visual calendar</h3>
        <p>See every draft, scheduled, and published post at a glance, with drag-to-reschedule and status filters.</p>
      </div>
      <div class="landing-feature">
        <span class="landing-feature-icon">🔗</span>
        <h3>Multi-platform posting</h3>
        <p>Connect Mastodon, Facebook Pages, and Instagram &mdash; one composer, with the right character limit for each.</p>
      </div>
      <div class="landing-feature">
        <span class="landing-feature-icon">🖼️</span>
        <h3>Media &amp; alt text</h3>
        <p>Attach up to 10 photos or videos per post, each with its own alt text for accessibility.</p>
      </div>
      <div class="landing-feature">
        <span class="landing-feature-icon">🤖</span>
        <h3>Built for AI agents</h3>
        <p>A built-in MCP server and personal API tokens let your agents draft and schedule posts on your behalf.</p>
      </div>
    </section>
  </main>

  <footer class="landing-footer">
    <span>&copy; <%= new Date().getFullYear() %> Postfox</span>
  </footer>
</div>
</body>
</html>
