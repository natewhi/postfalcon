<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js"></script>
<meta name="color-scheme" content="light dark">
<title>Reset password - Postfalcon</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css">
</head>
<body class="dark-canvas">
<%- include('partials/site-header') %>
<main class="auth-card">
  <div class="auth-card-head">
    <h1>Reset password</h1>
    <p class="auth-sub">Choose a new password for your account.</p>
  </div>
  <form id="reset-password-form">
    <input type="hidden" name="token" value="<%= token %>">
    <label>New password <input type="password" name="password" autocomplete="new-password" required minlength="8"></label>
    <button type="submit">Reset password</button>
  </form>
  <p id="error" class="error"></p>
  <div class="auth-card-footer">
    <a href="/login">Back to log in</a>
  </div>
</main>
<script src="/csrf.js"></script>
<script src="/reset-password.js"></script>
<%- include('partials/analytics') %>
</body>
</html>
