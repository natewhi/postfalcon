<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Log in - <%= siteName %></title>
<link rel="icon" href="<%= logoUrl || '/favicon.svg' %>">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="dark-canvas">
<%- include('partials/site-header') %>
<main class="auth-card">
  <div class="auth-card-head">
    <h1>Log in to <%= siteName %></h1>
  </div>
  <% if (googleSignIn) { %>
    <a href="/api/auth/google" class="btn-google"><%- include('partials/google-g') %>Continue with Google</a>
    <div class="auth-divider"><span>or</span></div>
  <% } %>
  <form id="login-form">
    <label>Email <input type="email" name="email" autocomplete="email" autofocus required></label>
    <label>Password
      <div class="password-field">
        <input type="password" name="password" id="login-password" autocomplete="current-password" required>
        <button type="button" class="password-toggle" aria-label="Hold to show password" aria-pressed="false">
          <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
            <line class="icon-eye-slash" x1="2" y1="2" x2="22" y2="22"/>
          </svg>
        </button>
      </div>
    </label>
    <button type="submit">Log in</button>
  </form>
  <p id="error" class="error"></p>
  <div class="auth-card-footer">
    <a href="/forgot-password">Forgot password?</a>
    <span class="auth-card-footer-sep" aria-hidden="true">&middot;</span>
    <span>No account? <a href="/signup">Sign up</a></span>
  </div>
</main>
<script src="/csrf.js?v=<%= assetVersion %>"></script>
<script src="/login.js?v=<%= assetVersion %>"></script>
<%- include('partials/analytics') %>
</body>
</html>
