<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Admin - Activity - <%= siteName %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'admin', email }) %>

  <main class="app-main">
    <div class="page-header">
      <h1>Admin &mdash; Activity</h1>
    </div>

    <section class="admin-section">
      <h2>Server errors</h2>
      <p class="hint">Everything the app logged as an error in the last 30 days, newest first: failed requests, scheduler and platform problems, failed backups. Open one for the full technical detail.</p>
      <div class="admin-filter-bar is-plain">
        <button type="button" id="errors-refresh" class="btn-secondary">Refresh</button>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th class="nowrap">Time</th><th>Where</th><th>What happened</th></tr></thead>
          <tbody id="errors-body"><tr><td colspan="3" class="empty"><span class="spinner"></span> Loading&hellip;</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="admin-section">
      <h2>Billing</h2>
      <p class="hint">Each account's plan as Postfalcon holds it. The billing check re-reads every subscriber from Stripe and corrects any that disagree (it also runs nightly). Accounts with no Stripe subscription, like a review login set to active by hand, are left alone.</p>
      <form id="billing-filter" class="admin-filter-bar">
        <div class="admin-filter-field">
          <label for="billing-email">Email</label>
          <input type="text" id="billing-email" name="email" placeholder="contains…">
        </div>
        <div class="admin-filter-field">
          <label for="billing-status">Status</label>
          <select id="billing-status" name="status">
            <option value="">All</option>
            <option>trialing</option>
            <option>active</option>
            <option>past_due</option>
            <option>canceled</option>
            <option>incomplete</option>
          </select>
        </div>
        <button type="submit">Filter</button>
        <button type="button" id="billing-reconcile" class="btn-secondary">Run billing check now</button>
      </form>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th>Email</th><th class="nowrap">Plan</th><th class="nowrap">Status</th><th class="nowrap">Renews / trial ends</th><th class="nowrap">Cancels</th><th class="nowrap">Stripe customer</th></tr>
          </thead>
          <tbody id="billing-body"></tbody>
        </table>
      </div>
      <div class="admin-pager">
        <button type="button" id="billing-prev">&larr; Prev</button>
        <span id="billing-status-text"></span>
        <button type="button" id="billing-next">Next &rarr;</button>
      </div>
    </section>

    <section class="admin-section">
      <h2>Auth events</h2>
      <form id="auth-events-filter" class="admin-filter-bar">
        <div class="admin-filter-field">
          <label for="auth-events-email">Email</label>
          <input type="text" id="auth-events-email" name="email" placeholder="contains…">
        </div>
        <div class="admin-filter-field">
          <label for="auth-events-type">Event type</label>
          <select id="auth-events-type" name="eventType">
            <option value="">All</option>
            <option>login_success</option>
            <option>login_failure</option>
            <option>logout</option>
            <option>signup</option>
            <option>password_change</option>
            <option>password_reset_request</option>
            <option>password_reset_complete</option>
            <option>account_deleted</option>
            <option>email_verified</option>
            <option>api_token_created</option>
            <option>api_token_revoked</option>
          </select>
        </div>
        <div class="admin-filter-field">
          <label for="auth-events-from">From</label>
          <input type="datetime-local" id="auth-events-from" name="from">
        </div>
        <div class="admin-filter-field">
          <label for="auth-events-to">To</label>
          <input type="datetime-local" id="auth-events-to" name="to">
        </div>
        <button type="submit">Filter</button>
      </form>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th class="nowrap">Time</th><th class="nowrap">Event</th><th>Email</th><th class="nowrap">User ID</th><th>IP</th><th>User agent</th></tr>
          </thead>
          <tbody id="auth-events-body"></tbody>
        </table>
      </div>
      <div class="admin-pager">
        <button type="button" id="auth-events-prev">&larr; Prev</button>
        <span id="auth-events-status"></span>
        <button type="button" id="auth-events-next">Next &rarr;</button>
      </div>
    </section>

    <section class="admin-section">
      <h2>Page visits</h2>
      <form id="page-visits-filter" class="admin-filter-bar">
        <div class="admin-filter-field">
          <label for="page-visits-email">Email</label>
          <input type="text" id="page-visits-email" name="email" placeholder="contains…">
        </div>
        <div class="admin-filter-field">
          <label for="page-visits-path">Path</label>
          <input type="text" id="page-visits-path" name="path" placeholder="contains…">
        </div>
        <div class="admin-filter-field">
          <label for="page-visits-from">From</label>
          <input type="datetime-local" id="page-visits-from" name="from">
        </div>
        <div class="admin-filter-field">
          <label for="page-visits-to">To</label>
          <input type="datetime-local" id="page-visits-to" name="to">
        </div>
        <button type="submit">Filter</button>
      </form>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th class="nowrap">Time</th><th>Path</th><th>Email</th><th class="nowrap">User ID</th><th>IP</th><th>User agent</th></tr>
          </thead>
          <tbody id="page-visits-body"></tbody>
        </table>
      </div>
      <div class="admin-pager">
        <button type="button" id="page-visits-prev">&larr; Prev</button>
        <span id="page-visits-status"></span>
        <button type="button" id="page-visits-next">Next &rarr;</button>
      </div>
    </section>

    <section class="admin-section">
      <h2>Product events</h2>
      <form id="product-events-filter" class="admin-filter-bar">
        <div class="admin-filter-field">
          <label for="product-events-email">Email</label>
          <input type="text" id="product-events-email" name="email" placeholder="contains…">
        </div>
        <div class="admin-filter-field">
          <label for="product-events-name">Event name</label>
          <input type="text" id="product-events-name" name="eventName" list="product-event-names" placeholder="e.g. post_created">
          <datalist id="product-event-names">
            <option value="social_account_connected">
            <option value="social_account_disconnected">
            <option value="post_created">
            <option value="post_scheduled">
            <option value="post_deleted">
            <option value="post_published">
            <option value="post_failed">
            <option value="signup_attempt_failed">
          </datalist>
        </div>
        <div class="admin-filter-field">
          <label for="product-events-from">From</label>
          <input type="datetime-local" id="product-events-from" name="from">
        </div>
        <div class="admin-filter-field">
          <label for="product-events-to">To</label>
          <input type="datetime-local" id="product-events-to" name="to">
        </div>
        <button type="submit">Filter</button>
      </form>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th class="nowrap">Time</th><th class="nowrap">Event</th><th>Email</th><th class="nowrap">User ID</th><th>Metadata</th></tr>
          </thead>
          <tbody id="product-events-body"></tbody>
        </table>
      </div>
      <div class="admin-pager">
        <button type="button" id="product-events-prev">&larr; Prev</button>
        <span id="product-events-status"></span>
        <button type="button" id="product-events-next">Next &rarr;</button>
      </div>
    </section>
  </main>
</div>

<script src="/csrf.js?v=<%= assetVersion %>"></script>
<script src="/common.js?v=<%= assetVersion %>"></script>
<script src="/admin-activity.js?v=<%= assetVersion %>"></script>
</body>
</html>
