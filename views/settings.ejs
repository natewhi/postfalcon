<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Settings - <%= siteName %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'settings', email }) %>

  <main class="app-main">
    <%- include('partials/verify-banner', { emailVerified }) %>
    <%- include('partials/trial-banner', { planBanner }) %>

    <div class="page-header">
      <h1>Settings</h1>
    </div>

    <section class="settings-section">
      <h2>Account</h2>
      <dl class="account-info">
        <div>
          <dt>Email</dt>
          <dd>
            <%= email %>
            <% if (emailVerified) { %><span class="status status-posted">Verified</span><% } else { %><span class="status status-failed">Unverified</span><% } %>
          </dd>
        </div>
        <div>
          <dt>Member since</dt>
          <dd><%= new Date(createdAt).toLocaleDateString() %></dd>
        </div>
        <% if (hasGoogle) { %>
        <div>
          <dt>Sign-in</dt>
          <dd>Google<% if (hasPassword) { %> + password<% } %></dd>
        </div>
        <% } %>
      </dl>
    </section>

    <section class="settings-section">
      <h2>Plan</h2>
      <p id="plan-summary" class="hint">Loading&hellip;</p>
      <div class="token-actions">
        <% if (billingEnabled) { %><a href="/pricing" class="btn-secondary">See plans</a><% } %>
        <button type="button" id="manage-billing-btn" hidden>Manage billing</button>
      </div>
    </section>

    <section class="settings-section">
      <h2>API access for agents</h2>
      <p class="hint">Generate a personal API token so AI agents (via MCP) or scripts can create and manage posts on your behalf. See the <a href="/api-docs">API docs</a> for endpoints and examples.</p>
      <p id="api-token-status" class="hint">Checking&hellip;</p>
      <div id="api-token-reveal" class="composer-field" hidden>
        <label for="api-token-value">Your new token <span class="label-optional">(copy it now &mdash; you won't see it again)</span></label>
        <div class="token-input-row">
          <input type="text" id="api-token-value" readonly>
          <button type="button" id="api-token-copy">Copy</button>
        </div>
      </div>
      <div class="token-actions">
        <button type="button" id="api-token-generate">Generate API token</button>
        <button type="button" id="api-token-revoke" class="delete-btn" hidden>Revoke token</button>
      </div>
    </section>

    <section class="settings-section" id="webhooks-section" hidden>
      <h2>Outbound webhooks</h2>
      <p class="hint">Postfalcon will POST a JSON payload to your endpoint when a post is published or fails. Each delivery is signed with <code>X-Postfalcon-Signature: sha256=&lt;hex&gt;</code> (HMAC-SHA256 of the raw body using the signing secret). See the <a href="/api-docs">API docs</a> for the payload shape.</p>
      <ul id="webhooks-list" class="webhooks-list"></ul>
      <div id="webhook-secret-reveal" class="composer-field" hidden>
        <label for="webhook-secret-value">Signing secret <span class="label-optional">(copy it now &mdash; you won't see it again)</span></label>
        <div class="token-input-row">
          <input type="text" id="webhook-secret-value" readonly>
          <button type="button" id="webhook-secret-copy">Copy</button>
        </div>
      </div>
      <form id="webhook-add-form" class="settings-form">
        <label>Endpoint URL <input type="url" name="url" placeholder="https://example.com/hooks/postfalcon" required></label>
        <button type="submit">Add webhook</button>
      </form>
    </section>

    <section class="settings-section">
      <h2><%= hasPassword ? 'Change password' : 'Set a password' %></h2>
      <p class="hint">
        <% if (hasPassword) { %>Update the password you use to log in.<% } else { %>
        You signed up with Google, so there's no password yet. Set one so you can also log in
        directly, as a fallback if you ever lose access to that Google account.
        <% } %>
      </p>
      <form id="change-password-form" class="settings-form">
        <% if (hasPassword) { %><label>Current password <input type="password" name="currentPassword" required></label><% } %>
        <label>New password <input type="password" name="newPassword" required minlength="8"></label>
        <label>Confirm new password <input type="password" name="confirmNewPassword" required minlength="8"></label>
        <button type="submit"><%= hasPassword ? 'Update password' : 'Set password' %></button>
      </form>
    </section>

    <section class="danger-zone settings-section">
      <h2>Delete account</h2>
      <p class="hint">Permanently deletes your account, connected social accounts, and all scheduled posts. This cannot be undone.</p>
      <form id="delete-account-form" class="settings-form">
        <% if (hasPassword) { %><label>Password <input type="password" name="password" required></label><% } %>
        <button type="submit" class="delete-btn">Delete my account</button>
      </form>
    </section>
  </main>
</div>

<script src="/csrf.js?v=<%= assetVersion %>"></script>
<script src="/common.js?v=<%= assetVersion %>"></script>
<script src="/settings.js?v=<%= assetVersion %>"></script>
</body>
</html>
