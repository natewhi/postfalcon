<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Admin - Platforms - <%= siteName %></title>
<link rel="icon" href="<%= logoUrl || '/favicon.svg' %>">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'admin-platforms', email }) %>

  <main class="app-main">
    <div class="page-header">
      <h1>Admin &mdash; Platforms</h1>
    </div>

    <section class="admin-section">
      <h2>Which platforms this server offers</h2>
      <p class="hint">
        <strong>On</strong>: shown on the Accounts page and the website, and people can connect it.
        <strong>Off</strong>: hidden, its connect link stops working, and scheduled posts to it are paused
        (they fail with a "temporarily unavailable" message and can be retried once it's back on).
        A platform needs its app credentials in <code>.env</code> before turning it on is useful &mdash;
        open <strong>How to set up</strong> under each one for where to get them and the callback URL to
        register (restart the app after editing <code>.env</code>).
        Changes apply immediately, with no deploy.
      </p>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th>Platform</th><th class="nowrap">Status</th><th class="nowrap">Credentials</th><th class="nowrap">Accounts</th><th class="nowrap">Scheduled</th><th></th></tr>
          </thead>
          <tbody id="platforms-body"><tr><td colspan="6" class="empty"><span class="spinner"></span> Loading&hellip;</td></tr></tbody>
        </table>
      </div>
    </section>
  </main>
</div>

<script src="/csrf.js?v=<%= assetVersion %>"></script>
<script src="/common.js?v=<%= assetVersion %>"></script>
<script src="/admin-platforms.js?v=<%= assetVersion %>"></script>
</body>
</html>
