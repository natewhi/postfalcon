<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Postfox</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
  <h1>Postfox</h1>
  <div>
    <span><%= email %></span>
    <button id="logout-btn">Log out</button>
  </div>
</header>
<main>
  <section>
    <h2>Connected Accounts</h2>
    <ul id="accounts-list"></ul>

    <form id="mastodon-connect-form" action="/api/mastodon/connect" method="GET">
      <input type="text" name="instance" placeholder="yourinstance.social" required>
      <button type="submit">Connect Mastodon</button>
    </form>

    <p class="hint">Other platforms aren't wired up to real posting yet — this adds a placeholder account useful for testing scheduling.</p>
    <form id="account-form">
      <select name="platform" required>
        <option value="twitter">Twitter/X</option>
        <option value="instagram">Instagram</option>
        <option value="facebook">Facebook</option>
        <option value="linkedin">LinkedIn</option>
        <option value="tiktok">TikTok</option>
        <option value="threads">Threads</option>
      </select>
      <input type="text" name="display_name" placeholder="Display name (e.g. @handle)" required>
      <button type="submit">Add placeholder account</button>
    </form>
  </section>

  <section>
    <h2>Posts</h2>
    <ul id="posts-list"></ul>
    <button id="new-post-btn" type="button">+ New post</button>
  </section>

  <section>
    <h2>Calendar</h2>
    <p class="hint">Click a day or time slot to schedule a post there. Drag a scheduled post to move it. Click a post to view details or delete it.</p>
    <div id="calendar"></div>
  </section>
</main>

<dialog id="post-dialog">
  <form id="post-dialog-form">
    <h3>New post</h3>
    <label>Account
      <select name="social_account_id" id="account-select" required></select>
    </label>
    <label>Content
      <textarea name="content" placeholder="What do you want to post?" required></textarea>
    </label>
    <label>Photo or video (optional)
      <input type="file" name="media" accept="image/*,video/*">
    </label>
    <label>Schedule for (leave blank to save as a draft)
      <input type="datetime-local" name="scheduled_for">
    </label>
    <div class="dialog-actions">
      <button type="button" id="post-dialog-cancel">Cancel</button>
      <button type="submit">Save</button>
    </div>
  </form>
</dialog>

<script src="/vendor/fullcalendar/index.global.min.js"></script>
<script src="/dashboard.js"></script>
</body>
</html>
