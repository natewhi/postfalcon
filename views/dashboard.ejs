<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js"></script>
<meta name="color-scheme" content="light dark">
<title>Postfalcon</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'calendar', email }) %>

  <main class="app-main dashboard-main">
    <%- include('partials/verify-banner', { emailVerified }) %>

    <div id="failed-posts-banner" class="attention-banner" hidden>
      <span id="failed-posts-message"></span>
    </div>

    <div class="page-header">
      <h1>Calendar</h1>
      <button id="new-post-btn" type="button">+ New post</button>
    </div>

    <div class="dashboard-stats" id="dashboard-stats">
      <span class="dashboard-stat"><strong id="stat-scheduled">0</strong> scheduled</span>
      <span class="dashboard-stat"><strong id="stat-drafts">0</strong> drafts</span>
      <span class="dashboard-stat"><strong id="stat-failed">0</strong> failed</span>
    </div>

    <div class="dashboard-columns">
      <div class="calendar-col">
        <section class="calendar-section">
          <h2>Calendar</h2>
          <p class="hint">Click a day or time slot to schedule a post there. Drag a scheduled post to move it, or drag a draft from the rail onto a date to schedule it. Click a scheduled post to edit or delete it.</p>
          <div class="status-filter" id="calendar-status-filter">
            <span class="status-filter-label">Show:</span>
            <button type="button" class="status-filter-chip" data-status="scheduled" aria-pressed="false">Scheduled</button>
            <button type="button" class="status-filter-chip" data-status="failed" aria-pressed="false">Failed</button>
            <button type="button" class="status-filter-chip" data-status="posted" aria-pressed="false">Posted</button>
            <button type="button" class="status-filter-chip" data-status="canceled" aria-pressed="false">Canceled</button>
          </div>
          <div id="calendar-loading" class="loading" style="display: none;"><span class="spinner"></span> Loading calendar…</div>
          <div id="calendar"></div>
        </section>
      </div>

      <div class="drafts-col">
        <section class="drafts-section">
          <h2>Drafts <span class="drafts-count" id="drafts-count" hidden>0</span></h2>
          <p class="hint">Drag a draft onto the calendar to schedule it.</p>
          <div class="drafts-filter">
            <input type="search" id="drafts-search" placeholder="Search drafts…" aria-label="Search drafts">
            <select id="drafts-platform-filter" aria-label="Filter drafts by platform">
              <option value="">All platforms</option>
            </select>
          </div>
          <ul id="drafts-list" class="drafts-list"></ul>
        </section>
      </div>
    </div>
  </main>
</div>

<dialog id="post-dialog">
  <form id="post-dialog-form">
    <div class="dialog-header">
      <h3 id="post-dialog-title">New post</h3>
      <button type="button" id="post-dialog-close" class="dialog-close" aria-label="Close">&times;</button>
    </div>

    <div class="composer-field">
      <span class="composer-label">Post to</span>
      <p id="crosspost-hint" class="hint">Pick one or more channels &mdash; posting to several cross-posts the same content.</p>
      <div id="account-picker" class="account-picker"></div>
      <input type="hidden" name="social_account_id" id="account-select" required>
    </div>

    <div class="composer-field">
      <textarea name="content" id="post-content" placeholder="What do you want to post?" required></textarea>
      <div class="composer-meta">
        <span id="char-count">0 characters</span>
      </div>
    </div>

    <div class="composer-field">
      <p id="media-edit-hint" class="hint" hidden>Media can't be changed once a post is created.</p>
      <div id="media-preview-grid" class="media-preview-grid"></div>
      <label class="media-upload-btn" id="media-upload-label">
        <input type="file" id="media-input" accept="image/*,video/*" multiple hidden>
        <span>Add photo or video <span class="label-optional">(up to 10)</span></span>
      </label>
    </div>

    <div class="composer-field tiktok-panel" id="tiktok-panel" hidden>
      <div class="tiktok-panel-header">
        <span class="composer-label">TikTok settings</span>
        <span class="tiktok-creator" id="tiktok-creator"></span>
      </div>
      <p class="hint" id="tiktok-status" hidden></p>

      <div id="tiktok-controls">
        <label class="tiktok-field">
          <span>Who can view this video</span>
          <select id="tiktok-privacy">
            <option value="">Select privacy level</option>
          </select>
        </label>

        <fieldset class="tiktok-field tiktok-interactions">
          <legend>Allow users to</legend>
          <label><input type="checkbox" id="tiktok-allow-comment"> Comment</label>
          <label><input type="checkbox" id="tiktok-allow-duet"> Duet</label>
          <label><input type="checkbox" id="tiktok-allow-stitch"> Stitch</label>
          <p class="hint" id="tiktok-interactions-note" hidden>Greyed-out options are turned off in your TikTok app settings.</p>
        </fieldset>

        <div class="tiktok-field">
          <label class="tiktok-toggle">
            <input type="checkbox" id="tiktok-disclose">
            <span>Disclose video content</span>
          </label>
          <p class="hint">Turn on to disclose that this video promotes goods or services in exchange for something of value. Your video could promote yourself, a third party, or both.</p>
          <div id="tiktok-disclose-options" class="tiktok-disclose-options" hidden>
            <label>
              <input type="checkbox" id="tiktok-brand-organic">
              <span><strong>Your brand</strong><br>You are promoting yourself or your own business. This video will be classified as Brand Organic.</span>
            </label>
            <label>
              <input type="checkbox" id="tiktok-brand-content">
              <span><strong>Branded content</strong><br>You are promoting another brand or a third party. This video will be classified as Branded Content.</span>
            </label>
            <p class="tiktok-disclose-label" id="tiktok-disclose-label"></p>
          </div>
        </div>

        <p class="hint" id="tiktok-duration-warning" hidden></p>
        <p class="tiktok-consent" id="tiktok-consent"></p>
        <p class="hint">After publishing, it can take a few minutes for TikTok to process the video before it appears on your profile.</p>
      </div>
    </div>

    <div class="composer-field">
      <span class="composer-label">When</span>
      <div class="schedule-toggle">
        <button type="button" class="schedule-option active" data-mode="draft">Save as draft</button>
        <button type="button" class="schedule-option" data-mode="schedule">Schedule</button>
      </div>
      <input type="datetime-local" name="scheduled_for" id="scheduled-for-input" disabled>
      <div id="repeat-fields" class="repeat-fields" hidden>
        <label class="repeat-field">
          <span>Repeat</span>
          <select id="repeat-select">
            <option value="">Don't repeat</option>
            <option value="daily">Every day</option>
            <option value="weekly">Every week</option>
            <option value="monthly">Every month</option>
          </select>
        </label>
        <label class="repeat-field" id="repeat-until-field" hidden>
          <span>Until</span>
          <input type="datetime-local" id="repeat-until-input">
        </label>
      </div>
    </div>

    <div class="dialog-actions">
      <button type="button" id="post-dialog-delete" class="delete-btn" hidden>Delete</button>
      <button type="button" id="post-dialog-cancel">Cancel</button>
      <button type="submit">Save</button>
    </div>
  </form>
</dialog>

<script src="/vendor/fullcalendar/index.global.min.js"></script>
<script src="/csrf.js"></script>
<script src="/common.js"></script>
<script src="/dashboard.js"></script>
</body>
</html>
