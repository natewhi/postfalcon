<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script src="/theme-init.js?v=<%= assetVersion %>"></script>
<meta name="color-scheme" content="light dark">
<title>Accounts - <%= siteName %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'accounts', email }) %>

  <main class="app-main">
    <%- include('partials/verify-banner', { emailVerified }) %>
    <%- include('partials/trial-banner', { planBanner }) %>

    <div class="page-header">
      <h1>Accounts</h1>
    </div>

    <section>
      <h2>Connected Accounts</h2>
      <%
        // Where each platform's "Reconnect" button goes: its OAuth start URL, or (for the
        // form-based connects) the form further down this page.
        const reconnectTargets = Object.fromEntries(
          platforms.map((p) => [p.id, p.connect === 'oauth' && p.connectPath ? p.connectPath : `#connect-${p.id}`])
        );
        reconnectTargets.instagram = '/api/facebook/connect';
      %>
      <ul id="accounts-list" data-reconnect="<%= JSON.stringify(reconnectTargets) %>"></ul>
    </section>

    <section>
      <h2>Connect a platform</h2>

      <%
        // These four blocks are hand-built (not from `platforms`), so each checks its own switch
        // from the admin Platforms page.
        const isOn = (id) => enabledIds.includes(id);
        const fbOn = isOn('facebook');
        const igOn = isOn('instagram');
      %>
      <% if (isOn('mastodon')) { %>
      <div class="connect-option" id="connect-mastodon">
        <h3>Mastodon</h3>
        <p class="hint">Enter your instance domain to connect via OAuth.</p>
        <form id="mastodon-connect-form" action="/api/mastodon/connect" method="GET">
          <input type="text" name="instance" placeholder="yourinstance.social" required>
          <button type="submit">Connect Mastodon</button>
        </form>
      </div>
      <% } %>

      <% if (fbOn || igOn) { %>
      <div class="connect-option" id="connect-facebook">
        <h3><%= fbOn && igOn ? 'Facebook & Instagram' : fbOn ? 'Facebook' : 'Instagram' %></h3>
        <p class="hint">
          <%= fbOn && igOn
            ? 'Connects any Facebook Pages you manage, and their linked Instagram business accounts.'
            : fbOn
              ? 'Connects any Facebook Pages you manage.'
              : 'Connects the Instagram business accounts linked to Facebook Pages you manage (you log in with Facebook).' %>
        </p>
        <a href="/api/facebook/connect" class="btn-link">Connect <%= fbOn && igOn ? 'Facebook / Instagram' : fbOn ? 'Facebook' : 'Instagram' %></a>
      </div>
      <% } %>

      <% if (isOn('telegram')) { %>
      <div class="connect-option" id="connect-telegram">
        <h3>Telegram</h3>
        <p class="hint">
          Create a bot with <a href="https://t.me/botfather" target="_blank" rel="noopener">@BotFather</a>, add it
          to your channel as an admin, then paste its token and the channel (e.g. <code>@yourchannel</code>).
        </p>
        <form id="telegram-connect-form">
          <input type="text" name="token" placeholder="Bot token (123456789:AA…)" required>
          <input type="text" name="chat_id" placeholder="@yourchannel or -100…" required>
          <button type="submit">Connect Telegram</button>
        </form>
      </div>
      <% } %>

      <% if (isOn('bluesky')) { %>
      <div class="connect-option" id="connect-bluesky">
        <h3>Bluesky</h3>
        <p class="hint">
          Enter your handle and an
          <a href="https://bsky.app/settings/app-passwords" target="_blank" rel="noopener">app password</a>
          (Settings &rarr; App Passwords) &mdash; not your main account password.
        </p>
        <form id="bluesky-connect-form">
          <input type="text" name="handle" placeholder="yourname.bsky.social" required>
          <input type="text" name="app_password" placeholder="xxxx-xxxx-xxxx-xxxx" required>
          <button type="submit">Connect Bluesky</button>
        </form>
      </div>
      <% } %>

      <% platforms.filter((p) => p.connect === 'oauth' && p.connectPath && p.id !== 'facebook').forEach((p) => { %>
      <div class="connect-option" id="connect-<%= p.id %>">
        <h3><%= p.label %></h3>
        <% if (p.hint) { %><p class="hint"><%= p.hint %></p><% } %>
        <% if (p.id === 'youtube') { %>
        <p class="hint">
          Postfalcon uses YouTube API Services. By connecting, you agree to the
          <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube Terms of Service</a>;
          see also the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google Privacy Policy</a>.
        </p>
        <% } %>
        <a href="<%= p.connectPath %>" class="btn-link">Connect <%= p.label %></a>
      </div>
      <% }); %>

      <% const stubPlatforms = platforms.filter((p) => p.status === 'stub' && p.connect === 'manual'); %>
      <% if (stubPlatforms.length) { %>
      <div class="connect-option">
        <h3>Other platforms</h3>
        <p class="hint">
          <%= stubPlatforms.map((p) => p.label).join(', ') %> aren't wired up to real posting yet
          &mdash; this adds a placeholder account useful for testing scheduling.
        </p>
        <form id="account-form">
          <select name="platform" required>
            <% stubPlatforms.forEach((p) => { %>
            <option value="<%= p.id %>"><%= p.label %></option>
            <% }); %>
          </select>
          <input type="text" name="display_name" placeholder="Display name (e.g. @handle)" required>
          <button type="submit">Add placeholder account</button>
        </form>
      </div>
      <% } %>

      <% const unsupportedPlatforms = platforms.filter((p) => p.status === 'unsupported'); %>
      <% if (unsupportedPlatforms.length) { %>
      <div class="connect-option">
        <h3>Not yet available</h3>
        <p class="hint">These platforms have no public content-publishing API to schedule against.</p>
        <ul class="platform-unavailable-list">
          <% unsupportedPlatforms.forEach((p) => { %>
          <li>
            <strong><%= p.label %></strong><% if (p.hint) { %> &mdash; <%= p.hint %><% } %>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } %>
    </section>
  </main>
</div>

<script src="/csrf.js?v=<%= assetVersion %>"></script>
<script src="/common.js?v=<%= assetVersion %>"></script>
<script src="/accounts.js?v=<%= assetVersion %>"></script>
</body>
</html>
