DATABASE_URL=postgresql://user:password@localhost:5432/postfalcon
PORT=3000
SESSION_SECRET=change-me
# Set to "production" on the VPS (behind HTTPS) so cookies are marked secure and trust proxy is enabled.
# Leave unset on the dev VM (plain HTTP).
NODE_ENV=production
# Publicly reachable base URL of this app, used to build OAuth redirect_uri values (e.g. Mastodon connect flow).
BASE_URL=http://localhost:3000
# Meta developer app credentials (App Settings -> Basic), used for Facebook Page + Instagram OAuth.
FACEBOOK_APP_ID=change-me
FACEBOOK_APP_SECRET=change-me
# Only for a Business-type Meta app using Facebook Login for Business: the login
# configuration's id (Facebook Login for Business -> Configurations). When set, the connect
# flow sends config_id instead of a scope list. Leave unset otherwise.
FACEBOOK_CONFIG_ID=
# Google Cloud OAuth client — shared by two unrelated features: the YouTube Data API v3 connect
# flow (posting) and "Sign in with Google" (logging into Postfalcon itself). One Google Cloud OAuth
# client works for both; in its Authorized redirect URIs, add BOTH:
#   <BASE_URL>/api/youtube/callback   (connect a YouTube channel)
#   <BASE_URL>/api/auth/google/callback   (sign in / sign up with Google)
# Leave unset to disable both the YouTube connect flow and Google sign-in.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# TikTok for Developers app (Login Kit + Content Posting API). Leave unset to disable the
# TikTok connect flow. Use the app's Production credentials, not the Sandbox ones (those are a
# separate key/secret pair). Until the app passes TikTok's Direct Post audit, posts can only be
# private.
TIKTOK_CLIENT_KEY=change-me
TIKTOK_CLIENT_SECRET=change-me
# Meta Threads API app (developers.facebook.com -> add the "Threads" product; separate
# credentials from FACEBOOK_APP_ID/SECRET above, even though it's the same Meta account).
# Leave unset to disable the Threads connect flow. Bluesky needs no app credentials — users
# connect with their own handle + an app password.
THREADS_CLIENT_ID=change-me
THREADS_CLIENT_SECRET=change-me
# LinkedIn app (developer.linkedin.com), with the "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn" products added — both are self-serve, no partner approval needed.
# Leave unset to disable the LinkedIn connect flow. Text posts only for now.
LINKEDIN_CLIENT_ID=change-me
LINKEDIN_CLIENT_SECRET=change-me
# Pinterest app (developers.pinterest.com), called "App ID"/"App secret" there. Leave unset to
# disable the Pinterest connect flow. Pins always need an image and post to the account's first
# board (chosen automatically at connect time; a "Postfalcon" board is created if there's none).
# While the app only has Trial access, Pinterest refuses Pins in production: set
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com, then remove it (and reconnect) once
# Standard access is approved. The sandbox also rejects normal OAuth tokens, so set
# PINTEREST_SANDBOX_TOKEN to a token from developers.pinterest.com -> My apps -> Manage (it
# covers only the developer's own sandbox, for recording the upgrade demo). Remove both after.
# PINTEREST_API_BASE=
# PINTEREST_SANDBOX_TOKEN=
PINTEREST_APP_ID=change-me
PINTEREST_APP_SECRET=change-me
# How many days to keep uploaded media for posted/failed/canceled posts before the
# daily cleanup job deletes the files (post text/history is kept either way).
MEDIA_RETENTION_DAYS=30
# Optional: keep uploaded media in a Backblaze B2 bucket instead of public/uploads on the
# server's own disk. Leave S3_BUCKET unset to keep using local disk. The bucket stays Private:
# the app streams files back at the same /uploads/<name> URLs.
#   S3_BUCKET            the bucket name (Buckets page)
#   S3_ENDPOINT          the bucket's "Endpoint", with https:// in front
#   S3_ACCESS_KEY_ID     Application Keys -> the key's keyID
#   S3_SECRET_ACCESS_KEY Application Keys -> the key's applicationKey (shown only once)
# The region is read from the endpoint. Set Caps & Alerts to $0 in Backblaze so going over the
# free tier stops the bucket instead of billing. Any other S3-compatible store (AWS S3,
# Cloudflare R2, Wasabi) works with the same variables plus S3_REGION.
S3_BUCKET=
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_FORCE_PATH_STYLE=false
# How many days to keep page-visit and auth-event audit log rows before the daily
# cleanup job deletes them.
ACTIVITY_LOG_RETENTION_DAYS=90
# How many days to keep product_events (feature usage) rows. Longer than the audit log
# window above since usage trends are useful over a longer horizon.
PRODUCT_EVENT_RETENTION_DAYS=365
# SMTP config for sending real emails (password reset, verification, security notices).
# Leave all four unset in dev to just log emails to the console instead of sending them.
SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
# Optional: defaults to SMTP_USER if unset.
SMTP_FROM=Postfalcon <noreply@example.com>
# Optional: pino log level (trace|debug|info|warn|error|fatal). Defaults to "info".
LOG_LEVEL=info
# Stripe billing. STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET from the Stripe dashboard
# (Developers -> API keys / Webhooks). STRIPE_PRICE_* are the recurring Price ids for each
# paid plan (Products -> your product -> Pricing). Leave unset in dev to disable billing —
# the pricing page still renders, but checkout returns an error until keys are set.
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
# Products, prices, portal plan switching and the webhook endpoint are created by
# `npm run stripe:setup` from the prices in lib/billing.js (run it after setting the secret key,
# in test or live mode, and again after any price change). It prints the webhook secret above
# when it creates the endpoint. The app finds prices by lookup key, so no Price ids go here.
# Set to true once live (after saving the Terms URL in Stripe's public business details) to
# make customers tick "I agree to the Terms" on the Checkout page. Stripe rejects Checkout with
# it on until that URL is saved, and a sandbox can't save one.
STRIPE_REQUIRE_TERMS=false
# (Legacy, optional: STRIPE_PRICE_<PLAN> / STRIPE_PRICE_<PLAN>_YEARLY ids are still honoured
# as a fallback if a plan has no lookup-keyed Price.)
# Self-hosted Umami analytics (traffic/referrer/SEO reporting — separate from the built-in
# page_visits/product_events tables, which stay focused on in-app usage). UMAMI_HOST is where
# THIS SERVER reaches your Umami instance (e.g. http://localhost:3002 if it's running on the
# same VM) — it's never exposed to visitors directly; routes/analytics.js proxies the
# tracking script and its data-collection endpoint through /stats/* on our own origin instead.
# UMAMI_WEBSITE_ID comes from Umami's own dashboard after you add this site there. Leave both
# unset to disable analytics entirely — see docs/analytics-setup.md.
UMAMI_HOST=change-me
UMAMI_WEBSITE_ID=change-me
# The /blog route and its content/blog/*.md posts are this project's own marketing content
# (including posts pitching self-hosting itself) — not something a self-hoster's instance
# should carry by default. Leave unset to keep it on (the original deployment's behavior);
# set to "false" to drop the /blog route, its nav/footer links, and its sitemap entries.
ENABLE_BLOG=true
# Legal name of whoever operates this instance, shown in public footers and the Terms/Privacy
# pages (Meta's business verification checks the site for it). Leave unset on a self-hosted
# instance that doesn't need it.
OPERATOR_NAME=
# Optional Australian Business Number, shown next to OPERATOR_NAME. Spaces optional.
OPERATOR_ABN=
