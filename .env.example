# Postfalcon configuration. Copy to .env and fill in the REQUIRED section; everything else is
# optional and can stay empty (empty = that feature is off). Restart the app after editing.
# README.md walks through it; Admin -> Overview lists anything still to do once it's running.

# ---------------------------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------------------------

# The public address of this server, with no trailing slash. Used for OAuth callbacks, links
# in emails and media URLs, so it must be what people (and the social platforms) actually reach.
BASE_URL=https://social.example.com
# A long random string that signs sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Docker Compose only (docker-compose.yml): the domain Caddy gets an HTTPS certificate for (the
# host part of BASE_URL; "localhost" to try it out), and the password for the bundled database.
DOMAIN=social.example.com
POSTGRES_PASSWORD=

# Without Docker: your Postgres connection string (Docker Compose sets this itself).
DATABASE_URL=postgresql://postfalcon:password@localhost:5432/postfalcon
PORT=3000
# "production" behind HTTPS (secure cookies, trusts the reverse proxy). Leave empty for plain
# http://localhost development.
NODE_ENV=production

# ---------------------------------------------------------------------------------------------
# EMAIL (optional, recommended): verification and password-reset emails. Without all four
# SMTP_* values, emails are only written to the log.
# ---------------------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who emails come from; quote it if it has <angle brackets>. Defaults to SMTP_USER.
SMTP_FROM="Postfalcon <noreply@social.example.com>"

# ---------------------------------------------------------------------------------------------
# SOCIAL PLATFORMS: one developer app per platform. Mastodon, Bluesky and Telegram need none.
# A platform is only offered to users once its keys are here. Admin -> Platforms ->
# "How to set up" shows, for each, where to create the app and the callback URL to register.
# ---------------------------------------------------------------------------------------------

# Facebook Pages + Instagram (one Meta app). FACEBOOK_CONFIG_ID only for a Business-type app
# using Facebook Login for Business (its login configuration's id).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
# Google Cloud OAuth client: YouTube posting AND "Sign in with Google". Register both
# <BASE_URL>/api/youtube/callback and <BASE_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok (Login Kit + Content Posting API). Use the Production key, not the Sandbox one.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Threads: its own Meta app, separate from the Facebook one.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Pinterest ("App ID" / "App secret"). Trial-access apps can only pin in the API sandbox: set
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com plus a developer-portal
# PINTEREST_SANDBOX_TOKEN to record Pinterest's Standard-access demo, then remove both.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_API_BASE=
PINTEREST_SANDBOX_TOKEN=
# LinkedIn (needs a LinkedIn Company Page to create the app). Off until switched on in
# Admin -> Platforms.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X: OAuth 2.0 "Web App"; posting needs a paid X API plan. Off until switched on in
# Admin -> Platforms.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# MEDIA STORAGE (optional): keep uploads in an S3-compatible bucket (Backblaze B2, AWS S3,
# Cloudflare R2, Wasabi) instead of the server's disk. Empty S3_BUCKET = local disk. The bucket
# stays private; the app streams files at the same /uploads/<name> URLs. Nightly database
# backups are copied to the bucket too.
# ---------------------------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# S3_FORCE_PATH_STYLE=false

# Days to keep uploaded media after a post is published/failed/canceled (the post itself stays).
MEDIA_RETENTION_DAYS=30
# Where nightly database backups go (default: backups/ in the app folder; the last 7 are kept).
# BACKUP_DIR=

# ---------------------------------------------------------------------------------------------
# BILLING (optional): only to SELL plans, like postfalcon.co. With no Stripe key the server is
# self-hosted: every account gets everything, with no limits, and no pricing pages are shown.
# ---------------------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Printed by `npm run stripe:setup`, which creates the products, prices, portal settings and
# webhook from lib/billing.js (run it after setting the key, and after any price change).
STRIPE_WEBHOOK_SECRET=
# true once live (after saving a Terms URL in Stripe's business details): customers must tick
# "I agree to the Terms" at Checkout.
STRIPE_REQUIRE_TERMS=false

# ---------------------------------------------------------------------------------------------
# EVERYTHING ELSE (optional)
# ---------------------------------------------------------------------------------------------

# Traffic analytics through a self-hosted Umami instance (docs/analytics-setup.md). UMAMI_HOST
# is where THIS server reaches Umami; visitors never talk to it directly.
UMAMI_HOST=
UMAMI_WEBSITE_ID=
# "false" removes the blog entirely. Otherwise it's shown with the public website, which is
# switched in Admin -> Settings (on by default only when billing is set up).
ENABLE_BLOG=true
# Legal name (and Australian Business Number) of whoever runs this server, shown in the footer
# and Terms/Privacy pages. Leave empty if you don't need it.
OPERATOR_NAME=
OPERATOR_ABN=
# Admin -> Overview -> Version compares this server with the project's GitHub main (one API call
# every 6 hours, only when an admin opens Overview). "false" turns that off; UPDATE_CHECK_REPO
# points a fork at its own repository ("owner/name"). APP_COMMIT names the running commit when
# there's no .git folder to read it from.
UPDATE_CHECK=
UPDATE_CHECK_REPO=
APP_COMMIT=
# Log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Days to keep the audit log (page visits, sign-ins) and feature-usage events.
ACTIVITY_LOG_RETENTION_DAYS=90
PRODUCT_EVENT_RETENTION_DAYS=365
