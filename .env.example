DATABASE_URL=postgresql://user:password@localhost:5432/postfox
PORT=3000
SESSION_SECRET=change-me
# Set to "production" on the VPS (behind HTTPS) so cookies are marked secure and trust proxy is enabled.
# Leave unset on the dev VM (plain HTTP).
NODE_ENV=production
# Publicly reachable base URL of this app, used to build OAuth redirect_uri values (e.g. Mastodon connect flow).
BASE_URL=http://localhost:3000
